# Default: free local demo mode. No API key or credit is required.
AGENT_MODE=demo

# Optional paid Anthropic mode: change AGENT_MODE to "anthropic" and add a key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Max times the agent is allowed to revise a decision after failing validation
MAX_AGENT_REVISIONS=2

# Max tool-use turns before the agent must submit a decision
MAX_TOOL_TURNS=8
